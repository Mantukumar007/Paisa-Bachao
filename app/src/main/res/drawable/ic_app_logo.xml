<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Outer Soft Glow / Shadow -->
    <path
        android:fillColor="#1A000000"
        android:pathData="M64,8 A56,56 0 1,0 64,120 A56,56 0 1,0 64,8 Z" />

    <!-- Emerald Shield / Circle Background -->
    <path
        android:pathData="M64,10 C93.82,10 118,34.18 118,64 C118,93.82 93.82,118 64,118 C34.18,118 10,93.82 10,64 C10,34.18 34.18,10 64,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="10"
                android:endX="108"
                android:endY="118"
                android:type="linear">
                <item android:color="#064E3B" android:offset="0.0" />
                <item android:color="#047857" android:offset="0.5" />
                <item android:color="#0D9488" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Golden Accent Ring -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M64,16 A48,48 0 1,0 64,112 A48,48 0 1,0 64,16 Z" />

    <!-- Concentric Decorative Ring -->
    <path
        android:strokeColor="#34D399"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:pathData="M64,21 A43,43 0 1,0 64,107 A43,43 0 1,0 64,21 Z" />

    <!-- Inner Golden Coin -->
    <path
        android:pathData="M64,25 A39,39 0 1,0 64,103 A39,39 0 1,0 64,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="25"
                android:endX="88"
                android:endY="103"
                android:type="linear">
                <item android:color="#FDE68A" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="0.5" />
                <item android:color="#D97706" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coin Bevel Ring -->
    <path
        android:strokeColor="#FEF3C7"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M64,30 A34,34 0 1,0 64,98 A34,34 0 1,0 64,30 Z" />

    <!-- Coin Inner Core -->
    <path
        android:fillColor="#B45309"
        android:pathData="M64,33 A31,31 0 1,0 64,95 A31,31 0 1,0 64,33 Z" />

    <path
        android:fillColor="#D97706"
        android:pathData="M64,34 A30,30 0 1,0 64,94 A30,30 0 1,0 64,34 Z" />

    <!-- Indian Rupee Symbol (₹) Crisp & Centered -->
    <!-- Top Horizontal Bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,46 H77 V50 H51 Z" />

    <!-- Second Horizontal Bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,54 H75 V58 H51 Z" />

    <!-- Upper Semi-Circle Loop -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,50 H64.5 C69,50 72,52.5 72,56.5 C72,60.5 69,63.5 64.5,63.5 H51 V59.5 H64 C66.5,59.5 68,58.2 68,56.5 C68,54.8 66.5,53.5 64,53.5 H51 Z" />

    <!-- Main Vertical Stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,46 H59 V82 H55 Z" />

    <!-- Diagonal Leg -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60.5,61.5 L76.5,82 H71 L56.5,63 Z" />

    <!-- Sparkle Stars for Wealth & Savings -->
    <path
        android:fillColor="#FEF3C7"
        android:pathData="M92,26 L93.5,31 L98.5,32.5 L93.5,34 L92,39 L90.5,34 L85.5,32.5 L90.5,31 Z" />

    <path
        android:fillColor="#FEF3C7"
        android:pathData="M32,88 L33.2,92 L37.2,93.2 L33.2,94.4 L32,98.4 L30.8,94.4 L26.8,93.2 L30.8,92 Z" />

    <path
        android:fillColor="#A7F3D0"
        android:pathData="M102,68 L103,71 L106,72 L103,73 L102,76 L101,73 L98,72 L101,71 Z" />

</vector>
